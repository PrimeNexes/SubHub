#!/bin/sh
# SubHub: lets any AI agent on this computer hand work to your other AI subscriptions ("subs").
# One script, no daemon: it finds every signed-in AI account, keeps a small registry, and runs a sub on request.
# https://github.com/PrimeNexes/SubHub · MIT licence
#
#   subhub list [--refresh]          the subs, what each is for, its limits and models (agents read this)
#   subhub models <sub>              every model that sub's CLI offers
#   subhub ask [--in <folder>] <sub> <model|default> <<'SUBHUB_BRIEF_END' … SUBHUB_BRIEF_END
#   subhub status [--json]           subs, agents and found accounts (the app reads --json)
#   subhub install                   put subhub on PATH and connect every installed agent
#   subhub connect|disconnect <agent|all>   claude, codex, gemini (Antigravity), cursor
#   subhub signin <sub>|claude --new [--email you@x.com] [--team]   sign an account in (interactive)
#   subhub remove <sub>              stop using a sub; discovery won't add it back
#   subhub on|off <sub>              turn a sub on or off
#   subhub config                    the settings file (on/off, use_for, model, notes, order)
#
# Exit codes of ask: 0 answer on stdout · 2 bad sub, model or folder · 3 loop guard · 4 empty answer
# 6 that sub is you · 7 not signed in / app not running · 8 turned off · 10 signed in as another account
# 124 timeout · 127 CLI missing
VERSION=1.0.2
SH="$HOME/.subhub"; REG="$SH/registry.tsv"; CFG="$SH/config.json"; IGN="$SH/ignored"; CACHE="$SH/cache"
TAB=$(printf '\t')
export USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-$(id -un)}"   # Claude reads its Keychain sign-in by user name
umask 077; mkdir -p "$SH" "$CACHE" "$SH/logs"; touch "$REG" "$IGN"

die() { code=$1; shift; echo "SubHub: $*" >&2; exit "$code"; }
# JSON from a string or a file: plutil on macOS, python3 elsewhere.
jget() {
  if command -v plutil >/dev/null 2>&1; then printf '%s' "$1" | plutil -extract "$2" raw -o - - 2>/dev/null
  else printf '%s' "$1" | python3 -c 'import json,sys
d=json.load(sys.stdin)
for k in sys.argv[1].split("."): d=d[int(k)] if isinstance(d,list) else d[k]
print(d if not isinstance(d,bool) else str(d).lower(),end="")' "$2" 2>/dev/null; fi
}
jfile() { [ -f "$1" ] && jget "$(cat "$1")" "$2"; }
lc() { tr 'A-Z' 'a-z'; }

bin_for() {
  case $1 in claude) b=claude ;; codex) b=codex ;; cursor) b=cursor-agent ;; gemini) b=agy ;; ollama) b=ollama ;; esac
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin /Applications/Ollama.app/Contents/Resources; do
    [ -x "$d/$b" ] && { echo "$d/$b"; return; }
  done
  command -v "$b" 2>/dev/null
}

# ---------- what each provider is for (shown to agents so they pick well) ----------
use_for() { case $1 in
  claude) echo "Claude Code on its own usage limit: big side tasks, or when another account is near its limit" ;;
  codex) echo "Second-opinion code review, debugging" ;;
  cursor) echo "Coding with the models on the Cursor plan" ;;
  gemini) echo "Huge context, PDFs and images, web research" ;;
  ollama) echo "Private data, bulk work, free" ;; esac; }
limits() { case $1 in
  claude) echo "Full Claude Code agent (files, shell, web, its account's skills and MCP servers). Same model family as Claude callers" ;;
  codex) echo "Full Codex agent (files, shell, network), no sandbox. OpenAI models: a real second opinion" ;;
  cursor) echo "Full Cursor agent (files, shell, its MCP servers), no sandbox. Models from the Cursor plan" ;;
  gemini) echo "Full Antigravity agent (files, shell, web), every permission auto-approved. Google models: a real second opinion" ;;
  ollama) echo "Text only: can't open files, run commands or browse; put everything in the brief or add < file. Runs on this computer: private and free, weaker at complex tasks. Only while Ollama is running: never start it" ;; esac; }

# ---------- who an account is: "email|org|label" (empty: signed out) ----------
claude_who() {   # $1 bin, $2 folder ("" = the default sign-in)
  if [ -n "$2" ]; then j=$(CLAUDE_CONFIG_DIR="$2" "$1" auth status 2>/dev/null) || return
  else j=$(env -u CLAUDE_CONFIG_DIR "$1" auth status 2>/dev/null) || return; fi
  e=$(jget "$j" email | lc); [ -n "$e" ] || return
  t=$(jget "$j" subscriptionType); n=$(jget "$j" orgName)
  T=$(printf '%s' "$t" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')
  case $t in team|enterprise) l="Claude $T · $n" ;; *) l="Claude $T" ;; esac
  printf '%s|%s|%s' "$e" "$(jget "$j" orgId)" "$l"
}
codex_who() {    # $1 CODEX_HOME
  tok=$(jfile "$1/auth.json" tokens.id_token) || return; [ -n "$tok" ] || return
  p=$(printf '%s' "$tok" | cut -d. -f2 | tr '_-' '/+'); while [ $((${#p} % 4)) -ne 0 ]; do p="$p="; done
  c=$(printf '%s' "$p" | base64 -D 2>/dev/null || printf '%s' "$p" | base64 -d 2>/dev/null)
  e=$(printf '%s' "$c" | grep -o '"email" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/' | lc)
  pl=$(printf '%s' "$c" | grep -o '"chatgpt_plan_type" *: *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
  [ -n "$e" ] && printf '%s|%s|%s' "$e" "${pl:-personal}" "ChatGPT ${pl:-}"
}
cursor_who() {
  o=$("$1" status 2>/dev/null | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g')
  e=$(printf '%s' "$o" | sed -n 's/.*Logged in as \([^ ]*\).*/\1/p' | head -1 | lc); [ -n "$e" ] || return
  t=$(printf '%s' "$o" | sed -n 's/^Team: \(.*\) (id .*/\1/p' | head -1)
  printf '%s|%s|%s' "$e" "${t:-personal}" "Cursor${t:+ · $t}"
  "$1" --list-models 2>/dev/null | sed 's/\x1b\[[0-9;?]*[A-Za-z]//g; s/\xe2\x80\x8b//g' > "$CACHE/cursor-models.txt"
}
gemini_who() {
  "$1" models > "$CACHE/gemini-models.txt" 2>/dev/null || return
  e=$(grep -h 'applyAuthResult: email=' "$HOME"/.gemini/antigravity-cli/log/* 2>/dev/null | tail -1 | sed 's/.*email=\([^,]*\).*/\1/' | lc)
  printf '%s|%s|%s' "${e:-google account}" google "Google account"
}

# Claude folders besides the default sign-in: ~/.claude-*, SubHub's own, and CLAUDE_CONFIG_DIR in shell profiles.
claude_dirs() {
  { for d in "$HOME"/.claude-* "$SH"/accounts/claude*; do [ -d "$d" ] && echo "$d"; done
    for rc in .zshrc .zprofile .zshenv .bashrc .bash_profile .profile .aliases .zsh_aliases; do
      [ -f "$HOME/$rc" ] && grep -o 'CLAUDE_CONFIG_DIR=["'"'"']*[^"'"'"' ;)]*' "$HOME/$rc" | sed 's/^CLAUDE_CONFIG_DIR=["'"'"']*//'
    done | sed "s|^~|$HOME|; s|\$HOME|$HOME|; s|\${HOME}|$HOME|" | while read -r d; do [ -d "$d" ] && echo "$d"; done
  } | while read -r d; do (cd "$d" 2>/dev/null && pwd -P); done | grep -vx "$(cd "$HOME/.claude" 2>/dev/null && pwd -P)" | awk '!s[$0]++'
}
codex_dirs() {
  echo ""
  for rc in .zshrc .zprofile .zshenv .bashrc .bash_profile .profile; do
    [ -f "$HOME/$rc" ] && grep -o 'CODEX_HOME=["'"'"']*[^"'"'"' ;)]*' "$HOME/$rc" | sed 's/^CODEX_HOME=["'"'"']*//; s|^~|'"$HOME"'|'
  done | while read -r d; do [ -d "$d" ] && (cd "$d" && pwd -P); done | awk '!s[$0]++'
}

# ---------- the registry: one line per sub, its pin (email|org) and its state ----------
#   name  provider  folder  email  org  label  state(ok|signedout|changed:<email>|missing|stopped)
reg_get() { awk -F"$TAB" -v n="$1" '$1==n' "$REG"; }
reg_field() { printf '%s' "$1" | cut -d"$TAB" -f"$2"; }
next_name() { n=$(awk -F"$TAB" -v p="$1" '$2==p { sub(/.*-/, "", $1); if ($1+0 > m) m = $1+0 } END { print m+1 }' "${2:-$REG}"); echo "$1-$n"; }

refresh() {
  new=$(mktemp); cp "$REG" "$new"
  setline() {  # name provider dir email org label state
    awk -F"$TAB" -v n="$1" '$1!=n' "$new" > "$new.t"; mv "$new.t" "$new"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "$7" >> "$new"
  }
  track() {  # provider dir who
    p=$1; d=$2; w=$3
    grep -qxF "$p:$d" "$IGN" && return
    old=$(awk -F"$TAB" -v p="$p" -v d="$d" '$2==p && $3==d' "$new" | head -1)
    e=${w%%|*}; r=${w#*|}; o=${r%%|*}; l=${r#*|}
    if [ -n "$old" ]; then
      n=$(reg_field "$old" 1); pe=$(reg_field "$old" 4); po=$(reg_field "$old" 5)
      if [ -z "$w" ]; then setline "$n" "$p" "$d" "$pe" "$po" "$(reg_field "$old" 6)" signedout
      elif [ "$e|$o" != "$pe|$po" ]; then setline "$n" "$p" "$d" "$pe" "$po" "$(reg_field "$old" 6)" "changed:$e"
      else setline "$n" "$p" "$d" "$e" "$o" "$l" ok; fi
    elif [ -n "$w" ]; then
      awk -F"$TAB" -v p="$p" -v k="$e|$o" '$2==p && ($4"|"$5)==k {f=1} END {exit !f}' "$new" && return   # already a sub
      setline "$(next_name "$p" "$new")" "$p" "$d" "$e" "$o" "$l" ok
    fi
  }
  if b=$(bin_for claude) && [ -n "$b" ]; then
    track claude "" "$(claude_who "$b" "")"
    claude_dirs > "$new.dirs"; while IFS= read -r d; do track claude "$d" "$(claude_who "$b" "$d")"; done < "$new.dirs"; rm -f "$new.dirs"
  fi
  if b=$(bin_for codex) && [ -n "$b" ]; then
    codex_dirs > "$new.dirs"; while IFS= read -r d; do track codex "$d" "$(codex_who "${d:-$HOME/.codex}")"; done < "$new.dirs"; rm -f "$new.dirs"
  fi
  if b=$(bin_for cursor) && [ -n "$b" ]; then track cursor "" "$(cursor_who "$b")"; fi
  if b=$(bin_for gemini) && [ -n "$b" ]; then track gemini "" "$(gemini_who "$b")"; fi
  if b=$(bin_for ollama) && [ -n "$b" ]; then
    if t=$(curl -s -m 2 "$(ollama_url)/api/tags"); then
      printf '%s' "$t" | grep -o '"name":"[^"]*"' | sed 's/"name":"//; s/"$//' | grep -v cloud > "$CACHE/ollama-models.txt"
      old=$(awk -F"$TAB" '$2=="ollama"' "$new" | head -1)
      setline "$( [ -n "$old" ] && reg_field "$old" 1 || next_name ollama "$new")" ollama "" "this computer" local "Ollama" ok
    else
      old=$(awk -F"$TAB" '$2=="ollama"' "$new" | head -1)
      [ -n "$old" ] && setline "$(reg_field "$old" 1)" ollama "" "this computer" local Ollama stopped
    fi
  fi
  sort -t"$TAB" -k1,1V "$new" > "$REG"; rm -f "$new"
}
ollama_url() { u=${OLLAMA_HOST:-127.0.0.1:11434}; case $u in http*) echo "$u" ;; *) echo "http://$u" ;; esac; }
fresh() { [ "$1" = --refresh ] || [ ! -s "$REG" ] || [ -n "$(find "$REG" -mmin +2 2>/dev/null)" ] && refresh; true; }

# ---------- user settings (~/.subhub/config.json, edited by the subhub-config skill) ----------
pref() { v=$(jfile "$CFG" "subs.$1.$2"); [ "$2" = model ] && [ "$v" = default ] && v=; printf '%s' "$v"; }
is_on() { [ "$(pref "$1" on)" != false ]; }
ranked() {  # names in the user's order, then the rest
  i=0; while o=$(jfile "$CFG" "order.$i"); do echo "$o"; i=$((i+1)); done
  awk -F"$TAB" '{print $1}' "$REG"
}

# ---------- models ----------
models() {  # $1 sub line, $2 short|full
  p=$(reg_field "$1" 2); n=$(reg_field "$1" 1)
  case $p in
    claude) printf -- "- \`fable\`: newest Claude Fable. For your toughest challenges\n- \`opus\`: newest Claude Opus. Most capable for ambitious work\n- \`sonnet\`: newest Claude Sonnet. Most efficient for everyday tasks\n- \`haiku\`: newest Claude Haiku. Fastest for quick answers\n- \`'opus[1m]'\` (also fable[1m], sonnet[1m]): 1M-token context. May use extra usage credits\n" ;;
    gemini) awk -F"$TAB" 'NF==2 { n=""; if ($1 ~ /^gemini-.*flash/) n=". 1M-token context; reads images, audio and video"; if ($1 ~ /-high$/) n=n "; thinks the most"; if ($1 ~ /-low$/) n=n "; thinks least, fastest"; printf "- `%s`: %s%s\n", $1, $2, n }' "$CACHE/gemini-models.txt" 2>/dev/null ;;
    cursor) f="$CACHE/cursor-models.txt"
      if [ "$2" = short ]; then
        echo "- \`auto\`: Cursor picks. $(grep -c ' - ' "$f" 2>/dev/null) models in all; ids: \`subhub models $n\`"
        printf -- "- families: %s\n" "$(sed -n 's/^[^ ]* - //p' "$f" 2>/dev/null | sed -E 's/ (Low|Medium|High|Extra High|Fast|Thinking|Minimal|None|Max|No|\(NO ZDR\))+$//; s/ (Low|Medium|High|Extra High|Fast|Thinking|Minimal|None|Max)( |$).*//' | awk '!s[$0]++' | grep -v default | head -40 | paste -sd, - | sed 's/,/, /g')"
      else sed -n 's/^\([^ ]*\) - \(.*\)/- `\1`: \2/p' "$f" 2>/dev/null; fi ;;
    codex) b=$(bin_for codex); j=$( [ -n "$(reg_field "$1" 3)" ] && CODEX_HOME="$(reg_field "$1" 3)" "$b" debug models 2>/dev/null || "$b" debug models 2>/dev/null)
      i=0; while s=$(jget "$j" "models.$i.slug"); do
        [ "$(jget "$j" "models.$i.visibility")" = list ] && printf -- "- \`%s\`: %s. %s; %sK context\n" "$s" "$(jget "$j" "models.$i.display_name")" "$(jget "$j" "models.$i.description" | sed 's/\.$//')" "$(( $(jget "$j" "models.$i.context_window" || echo 0) / 1000 ))"
        i=$((i+1)); done ;;
    ollama) sed 's/.*/- `&`/' "$CACHE/ollama-models.txt" 2>/dev/null ;;
  esac
}

# ---------- list (what agents read) ----------
cmd_list() {
  fresh "$1"
  echo "# Your subs (from SubHub)"; echo
  echo "Run one with \`subhub ask <sub> <model|default>\` and the brief on stdin (see the subhub skill). Never pick the account you are running as."; echo
  echo "| Sub | Account | Use it for | Can do, and limits |"; echo "|---|---|---|---|"
  ready=; off=; waiting=
  for n in $(ranked | awk '!s[$0]++'); do
    l=$(reg_get "$n"); [ -n "$l" ] || continue; p=$(reg_field "$l" 2); st=$(reg_field "$l" 7)
    if ! is_on "$n"; then off="$off $n"; continue; fi
    case $st in ok) ;; signedout) waiting="$waiting $n (signed out)"; continue ;; changed:*) waiting="$waiting $n (signed in as ${st#changed:}, not $(reg_field "$l" 4))"; continue ;; stopped) waiting="$waiting $n (Ollama isn't running)"; continue ;; *) continue ;; esac
    u=$(pref "$n" use_for); [ -n "$u" ] || u=$(use_for "$p")
    printf '| %s | %s, %s | %s | %s |\n' "$n" "$(reg_field "$l" 4)" "$(reg_field "$l" 6)" "$u" "$(limits "$p")"
    ready="$ready $n"
  done
  echo; echo "All subs start fresh (no memory of your conversation), run headless (they can't ask questions), with full access and no approval prompts, in the folder you call from (or \`--in <folder>\`), for up to 30 minutes."
  echo; echo "## Models"; echo; echo "Pass an id as the 2nd argument, or default. Quote ids with brackets."
  cl=; for n in $ready; do l=$(reg_get "$n"); m=$(pref "$n" model)
    if [ "$(reg_field "$l" 2)" = claude ]; then
      [ -n "$m" ] && { echo; echo "**$n**: the user picked \`$m\`: pass default unless the task needs another."; }
      [ -z "$cl" ] && cl=$l; continue; fi
    echo; echo "**$n**${m:+ (the user picked \`$m\`: pass default unless the task needs another)}"; models "$l" short; done
  [ -n "$cl" ] && { echo; echo "**Every Claude sub** ($(printf '%s\n' $ready | grep '^claude-' | paste -sd, - | sed 's/,/, /g'))"; models "$cl" short; }
  [ -n "$off" ] && { echo; echo "Turned off by the user, don't use:$off"; }
  [ -n "$waiting" ] && { echo; echo "Not ready:$waiting. The user fixes these with \`subhub status\`."; }
  true
}

cmd_models() {
  [ -n "$1" ] || die 2 "name a sub, for example: subhub models gemini-1"
  fresh; l=$(reg_get "$1"); [ -n "$l" ] || die 2 "no sub named '$1'. subhub list shows them."
  echo "# $1 models"; echo; models "$l" full
}

# ---------- ask ----------
cmd_ask() {
  [ "$1" = --in ] && { cd "$2" 2>/dev/null || die 2 "can't open the folder '$2'."; shift 2; }
  # Who is calling: a Claude Code session says so in its environment. Any agent may call.
  caller=; [ -n "${CLAUDE_CODE_USER_EMAIL:-}" ] && caller="$(printf '%s' "$CLAUDE_CODE_USER_EMAIL" | lc)|${CLAUDE_CODE_ORGANIZATION_UUID:-}"
  incc=${CLAUDECODE:-}; callerdir=${CLAUDE_CONFIG_DIR:-}
  # A sub uses its own sign-in, never the caller's.
  unset CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_HOST_SESSION_ID CLAUDE_CODE_CHILD_SESSION \
    CLAUDE_CODE_SESSION_ATTENDED CLAUDE_CODE_ACCOUNT_UUID CLAUDE_CODE_ORGANIZATION_UUID CLAUDE_CODE_USER_EMAIL \
    CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_REFRESH_TOKEN CLAUDE_CODE_OAUTH_SCOPES CLAUDE_CODE_SESSION_ACCESS_TOKEN \
    CLAUDE_CODE_SDK_HAS_HOST_AUTH_REFRESH CLAUDE_CODE_SDK_HAS_OAUTH_REFRESH CLAUDE_CODE_SDK_HAS_SESSIONS_OAUTH_REFRESH \
    CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_HOST_AUTH_ENV_VAR CLAUDE_CODE_HOST_CREDS_FILE
  TIMEOUT=${SUBHUB_TIMEOUT:-1800}; case $TIMEOUT in ''|*[!0-9]*) TIMEOUT=1800 ;; esac
  MAX=${SUBHUB_MAX_DEPTH:-1}; depth=${SUBHUB_DEPTH:-0}
  [ "$depth" -ge "$MAX" ] && die 3 "loop guard: depth $MAX reached"
  export SUBHUB_DEPTH=$((depth + 1))
  sub=$1; model=${2:-default}; task=$3; piped=
  if [ -z "$task" ] && [ ! -t 0 ]; then task=$(cat); piped=1; fi
  l=$(reg_get "$sub"); [ -n "$l" ] || { fresh --refresh; l=$(reg_get "$sub"); }
  [ -n "$l" ] || die 2 "unknown sub '$sub'. subhub list shows them."
  p=$(reg_field "$l" 2); d=$(reg_field "$l" 3); pe=$(reg_field "$l" 4); po=$(reg_field "$l" 5); st=$(reg_field "$l" 7)
  is_on "$sub" || die 8 "$sub is turned off."
  case $st in signedout) die 7 "$sub is signed out. Sign it in with: subhub signin $sub" ;;
    changed:*) die 10 "$sub isn't signed in as $pe any more (it's ${st#changed:}). Sign it in again: subhub signin $sub" ;;
    stopped) die 7 "Ollama isn't running. Start it yourself; SubHub never starts it." ;; missing) die 127 "$sub's folder is gone." ;; esac
  [ "$model" = default ] && { m=$(pref "$sub" model); [ -n "$m" ] && model=$m; }
  case $model in ''|*[!]A-Za-z0-9._:/[-]*) die 2 "'$model' isn't a model name." ;; esac
  notes=$(pref "$sub" notes)
  bin=$(bin_for "$p"); [ -n "$bin" ] && [ -x "$bin" ] || die 127 "$sub's CLI isn't installed."
  last=; stdin=
  case $p in
    claude)
      [ -n "$caller" ] && [ "$caller" = "$pe|$po" ] && die 6 "$sub is the account you're running as. Pick another sub."
      if [ -n "$incc" ]; then a=$(cd "${callerdir:-$HOME/.claude}" 2>/dev/null && pwd -P); b=$(cd "${d:-$HOME/.claude}" 2>/dev/null && pwd -P)
        [ "$a" = "$b" ] && die 6 "$sub is the Claude account you're running as. Pick another sub."; fi
      w=$(claude_who "$bin" "$d"); [ "${w%|*}" = "$pe|$po" ] || die 10 "$sub isn't signed in as $pe any more. Sign it in again: subhub signin $sub"
      if [ -n "$d" ]; then export CLAUDE_CONFIG_DIR="$d"; else unset CLAUDE_CONFIG_DIR; fi
      unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
      set -- "$bin" -p --permission-mode bypassPermissions --settings '{"disableAllHooks":true}' ;;
    codex) if [ -n "$d" ]; then export CODEX_HOME="$d"; else unset CODEX_HOME; fi
      set -- "$bin" exec --sandbox danger-full-access --skip-git-repo-check -c 'approval_policy="never"' ;;
    cursor) set -- "$bin" --force --sandbox disabled --trust --approve-mcps; last=-p ;;
    gemini) set -- "$bin" --dangerously-skip-permissions; last=-p ;;
    ollama) stdin=1; tags=$(curl -s -m 2 "$(ollama_url)/api/tags") || die 7 "Ollama isn't running. Start it yourself; SubHub never starts it."
      [ "$model" = default ] && model=$(head -1 "$CACHE/ollama-models.txt" 2>/dev/null)
      case $model in *:*) ;; *) model=$model:latest ;; esac
      case $tags in *"\"name\":\"$model\""*) ;; *) die 7 "$model isn't installed in Ollama, and SubHub won't download it." ;; esac
      set -- "$bin" run "$model" --hidethinking --nowordwrap; model=default ;;
  esac
  brief="Task from another AI agent. You're its sub-agent, working in $(pwd). You run headless: nobody can answer questions, so make sensible choices and finish. If you change any files, list them at the end.
$task"
  [ -n "$notes" ] && brief="$brief

Notes from the user for this sub:
$notes"
  brief="$brief

You are a sub-agent. Do not delegate further."
  log="$SH/logs/$sub.log"
  [ "$model" != default ] && set -- "$@" --model "$model"
  [ -n "$last" ] && set -- "$@" "$last"
  tmp=$(mktemp -d); in=/dev/null
  [ -n "$stdin" ] && [ -z "$piped" ] && [ -f /dev/fd/0 ] && { cat > "$tmp/in"; in="$tmp/in"; }
  snap() { git status --porcelain -uall 2>/dev/null; git diff 2>/dev/null; }
  before=; git rev-parse --is-inside-work-tree >/dev/null 2>&1 && before=$(snap | shasum)
  exec 3>&2 2>/dev/null; set -m
  "$@" "$brief" <"$in" >"$tmp/out" 2>>"$log" & pid=$!
  ( sleep "$TIMEOUT"; : > "$tmp/timedout"; kill -TERM -"$pid"; sleep 5; kill -KILL -"$pid" ) & wd=$!
  wait "$pid"; rc=$?
  kill -TERM -"$wd"; wait "$wd"; set +m; exec 2>&3 3>&-
  [ -e "$tmp/timedout" ] && rc=124
  answer=$(cat "$tmp/out"); rm -rf "$tmp"
  [ "$rc" -eq 0 ] && [ -z "$answer" ] && rc=4
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 124 ] && echo "SubHub: $sub timed out after $TIMEOUT seconds." >&2
    echo "SubHub: $sub failed (exit $rc). Last log lines:" >&2; tail -n 5 "$log" >&2
  fi
  [ -n "$answer" ] && printf '%s\n' "$answer"
  if [ -n "$before" ] && [ "$before" != "$(snap | shasum)" ]; then
    printf '\nSubHub: files in %s that changed while %s ran (git status; includes anything else working here):\n' "$(pwd)" "$sub"; git status --porcelain -uall
  fi
  exit "$rc"
}

# ---------- agents: Claude Code, Codex, Antigravity, Cursor ----------
SRC=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P)   # the plugin folder this script came with
RULES="subhub ~/.subhub/bin/subhub"
agent_bin() { case $1 in gemini) bin_for gemini ;; *) bin_for "$1" ;; esac; }
agent_name() { case $1 in claude) echo "Claude Code" ;; codex) echo Codex ;; gemini) echo Antigravity ;; cursor) echo Cursor ;; esac; }
agent_on() { case $1 in
  claude) grep -q '"subhub@' "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null || [ -x "$HOME/.claude/skills/subhub/bin/subhub" ] ;;
  codex) ls -d "${CODEX_HOME:-$HOME/.codex}"/plugins/cache/*/subhub >/dev/null 2>&1 || [ -f "${CODEX_HOME:-$HOME/.codex}/skills/subhub/SKILL.md" ] ;;
  gemini) [ -d "$HOME/.gemini/config/plugins/subhub" ] || [ -f "$HOME/.gemini/config/skills/subhub/SKILL.md" ] ;;
  cursor) [ -f "$HOME/.cursor/skills/subhub/SKILL.md" ] ;; esac; }
allow() {  # $1 add|remove, $2 JSON file, $3 rule. Edited as XML (unambiguous for plutil), written back as JSON.
  f=$2; [ -f "$f" ] || { [ "$1" = add ] || return 0; mkdir -p "$(dirname "$f")"; printf '{}\n' > "$f"; }
  [ -f "$f.subhub-backup" ] || cp "$f" "$f.subhub-backup"
  x=$(mktemp); plutil -convert xml1 -o "$x" "$f" 2>/dev/null || { rm -f "$x"; echo "  SubHub: $f isn't valid JSON; add $3 to permissions.allow yourself." >&2; return 0; }
  i=0; at=; while r=$(plutil -extract "permissions.allow.$i" raw -o - "$x" 2>/dev/null); do [ "$r" = "$3" ] && at=$i; i=$((i+1)); done
  if [ "$1" = add ]; then
    [ -n "$at" ] && { rm -f "$x"; return 0; }
    plutil -extract permissions xml1 -o /dev/null "$x" 2>/dev/null || plutil -insert permissions -dictionary "$x"
    plutil -extract permissions.allow xml1 -o /dev/null "$x" 2>/dev/null || plutil -insert permissions.allow -array "$x"
    plutil -insert permissions.allow -string "$3" -append "$x"
  elif [ -n "$at" ]; then plutil -remove "permissions.allow.$at" "$x"
  else rm -f "$x"; return 0; fi
  plutil -convert json -r -o - "$x" | sed 's#\\/#/#g' > "$f.t" && mv "$f.t" "$f"; rm -f "$x"
}
connect() {
  b=$(agent_bin "$1"); [ -n "$b" ] || { echo "  $(agent_name "$1"): not installed, skipped"; return 0; }
  case $1 in
    claude)
      { "$b" plugin marketplace remove subhub; "$b" plugin marketplace add "${SUBHUB_MARKET:-$SRC_REPO}"; } >/dev/null 2>&1
      { "$b" plugin install subhub@subhub && "$b" plugin update subhub@subhub; } >/dev/null 2>&1 \
        || { mkdir -p "$HOME/.claude/skills"; rm -rf "$HOME/.claude/skills/subhub"; cp -R "$SRC" "$HOME/.claude/skills/subhub"; }
      for r in $RULES; do allow add "$HOME/.claude/settings.json" "Bash($r *)"; done
      allow add "$HOME/.claude/settings.json" "Skill(subhub:subhub)" ;;
    codex) h=${CODEX_HOME:-$HOME/.codex}
      { "$b" plugin remove subhub; "$b" plugin marketplace remove subhub; "$b" plugin marketplace add "${SUBHUB_MARKET:-$SRC_REPO}"; } >/dev/null 2>&1
      "$b" plugin add subhub@subhub >/dev/null 2>&1 \
        || { mkdir -p "$h/skills"; rm -rf "$h/skills/subhub"; cp -R "$SRC/skills/subhub" "$h/skills/subhub"; }
      mkdir -p "$h/rules"; { echo "# Written by SubHub: lets Codex run subhub without asking."
        for r in $RULES; do echo "prefix_rule(pattern = [\"$(eval echo "$r")\"], decision = \"allow\")"; done; } > "$h/rules/subhub.rules" ;;
    gemini) { "$b" plugin uninstall subhub; } >/dev/null 2>&1; "$b" plugin install "$SRC" >/dev/null 2>&1 \
        || { mkdir -p "$HOME/.gemini/config/skills"; rm -rf "$HOME/.gemini/config/skills/subhub"; cp -R "$SRC/skills/subhub" "$HOME/.gemini/config/skills/subhub"; }
      for r in $RULES; do allow add "$HOME/.gemini/antigravity-cli/settings.json" "command($(eval echo "$r"))"; done ;;
    cursor) mkdir -p "$HOME/.cursor/skills"; rm -rf "$HOME/.cursor/skills/subhub"; cp -R "$SRC/skills/subhub" "$HOME/.cursor/skills/subhub"
      for r in $RULES; do allow add "$HOME/.cursor/cli-config.json" "Shell($(eval echo "$r"))"; done ;;
  esac
  echo "  $(agent_name "$1"): connected"
}
disconnect() {
  b=$(agent_bin "$1")
  case $1 in
    claude) [ -n "$b" ] && { "$b" plugin uninstall subhub@subhub; "$b" plugin marketplace remove subhub; } >/dev/null 2>&1
      [ -f "$HOME/.claude/skills/subhub/bin/subhub" ] && rm -rf "$HOME/.claude/skills/subhub"
      for r in $RULES; do allow remove "$HOME/.claude/settings.json" "Bash($r *)"; done
      allow remove "$HOME/.claude/settings.json" "Skill(subhub:subhub)" ;;
    codex) h=${CODEX_HOME:-$HOME/.codex}; [ -n "$b" ] && { "$b" plugin remove subhub; "$b" plugin marketplace remove subhub; } >/dev/null 2>&1
      rm -rf "$h/skills/subhub" "$h/rules/subhub.rules" ;;
    gemini) [ -n "$b" ] && "$b" plugin uninstall subhub >/dev/null 2>&1; rm -rf "$HOME/.gemini/config/skills/subhub"
      for r in $RULES; do allow remove "$HOME/.gemini/antigravity-cli/settings.json" "command($(eval echo "$r"))"; done ;;
    cursor) rm -rf "$HOME/.cursor/skills/subhub"
      for r in $RULES; do allow remove "$HOME/.cursor/cli-config.json" "Shell($(eval echo "$r"))"; done ;;
  esac
  echo "  $(agent_name "$1"): disconnected"
}
agents_arg() { [ "$1" = all ] && echo "claude codex gemini cursor" || echo "$1"; }

# Removes what the old SubHub app (before the plugin) wrote: its skills-dir plugin, relay agents and ask rules.
migrate() {
  old="$SH/ask"
  [ -f "$HOME/.claude/skills/subhub/.claude-plugin/plugin.json" ] && [ ! -e "$HOME/.claude/skills/subhub/bin/subhub" ] && rm -rf "$HOME/.claude/skills/subhub"
  for f in "$HOME"/.claude/agents/subhub-*.md; do [ -f "$f" ] && grep -q 'Written by SubHub' "$f" && rm -f "$f"; done
  allow remove "$HOME/.claude/settings.json" "Bash($old *)"
  allow remove "$HOME/.gemini/antigravity-cli/settings.json" "command($old)"
  allow remove "$HOME/.cursor/cli-config.json" "Shell($old)"
  for d in "$HOME/.gemini/config/skills/subhub" "${CODEX_HOME:-$HOME/.codex}/skills/subhub" "$HOME/.cursor/skills/subhub"; do
    [ -f "$d/SKILL.md" ] && grep -q 'Written by SubHub' "$d/SKILL.md" && rm -rf "$d"; done
  rm -rf "$SH/models" "$SH/subs.md" "$SH/run"
  printf '#!/bin/sh\n# Old name for subhub, kept so older sessions keep working.\ncase $1 in --list) exec "%s" list ;; --models) exec "%s" models "$2" ;; esac\nexec "%s" ask "$@"\n' "$SH/bin/subhub" "$SH/bin/subhub" "$SH/bin/subhub" > "$old"; chmod 755 "$old"
}

# On/off for one sub in config.json.
cmd_onoff() {
  [ -n "$(reg_get "$2")" ] || die 2 "unknown sub '$2'."
  [ -f "$CFG" ] || printf '{"subs":{},"order":[]}\n' > "$CFG"
  x=$(mktemp); plutil -convert xml1 -o "$x" "$CFG" || die 2 "$CFG isn't valid JSON."
  plutil -extract subs xml1 -o /dev/null "$x" 2>/dev/null || plutil -insert subs -dictionary "$x"
  plutil -extract "subs.$2" xml1 -o /dev/null "$x" 2>/dev/null || plutil -insert "subs.$2" -dictionary "$x"
  plutil -replace "subs.$2.on" -bool "$( [ "$1" = on ] && echo true || echo false)" "$x"
  plutil -convert json -r -o - "$x" | sed 's#\\/#/#g' > "$CFG.t" && mv "$CFG.t" "$CFG"; rm -f "$x"
  echo "$2 is $1."
}

cmd_install() {
  mkdir -p "$SH/bin" "$HOME/.local/bin"
  cp "$0" "$SH/bin/subhub"; chmod 755 "$SH/bin/subhub"
  ln -sf "$SH/bin/subhub" "$HOME/.local/bin/subhub"
  migrate
  echo "SubHub $VERSION: installed as ~/.local/bin/subhub"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "  Add ~/.local/bin to your PATH (agents also use ~/.subhub/bin/subhub directly)." ;; esac
  echo "Finding your AI accounts…"; refresh
  awk -F"$TAB" '{ printf "  %-10s %s · %s (%s)\n", $1, $4, $6, $7 }' "$REG"
  echo "Connecting agents…"; for a in claude codex gemini cursor; do connect "$a"; done
  echo "Done. Start a new session in any connected agent and ask it to use your subs."
}

cmd_status() {
  fresh "$2"
  if [ "$1" = --json ]; then
    q() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
    printf '{"version":"%s","subs":[' "$VERSION"; s=
    US=$(printf '\037'); tr '\t' '\037' < "$REG" | while IFS="$US" read -r n p d e o l st; do
      on=true; is_on "$n" || on=false
      printf '%s{"name":"%s","provider":"%s","folder":"%s","email":"%s","label":"%s","state":"%s","on":%s}' "$s" "$(q "$n")" "$p" "$(q "$d")" "$(q "$e")" "$(q "$l")" "$(q "$st")" "$on"; s=,
    done
    printf '],"agents":['; s=
    for a in claude codex gemini cursor; do
      inst=false; [ -n "$(agent_bin "$a")" ] && inst=true; c=false; agent_on "$a" && c=true
      printf '%s{"id":"%s","name":"%s","installed":%s,"connected":%s}' "$s" "$a" "$(agent_name "$a")" "$inst" "$c"; s=,
    done
    printf '],"found":['; s=
    found | tr '\t' '\037' | while IFS="$US" read -r e o n t; do printf '%s{"email":"%s","org":"%s","orgName":"%s","type":"%s"}' "$s" "$(q "$e")" "$o" "$(q "$n")" "$t"; s=,; done
    printf ']}\n'
  else
    echo "Subs:"; awk -F"$TAB" '{ printf "  %-10s %-28s %-26s %s\n", $1, $4, $6, $7 }' "$REG"
    echo "Agents:"; for a in claude codex gemini cursor; do
      if [ -z "$(agent_bin "$a")" ]; then s="not installed"; elif agent_on "$a"; then s="connected"; else s="not connected (subhub connect $a)"; fi
      printf '  %-12s %s\n' "$(agent_name "$a")" "$s"; done
    f=$(found); [ -n "$f" ] && { echo "Found, not signed in (subhub signin claude --new --email <email>):"; printf '%s\n' "$f" | awk -F"$TAB" '{ printf "  %s · %s\n", $1, ($4=="team"||$4=="enterprise") ? "Team " $3 : "Personal" }'; }
    true
  fi
}

# Claude organizations named in account records on this computer that no folder is signed in to.
found() {
  for f in "$HOME/.claude.json" "$HOME"/.claude/backups/.claude.json.backup.* "$HOME"/.claude-*/.claude.json \
           "$HOME/Library/Application Support/Claude/local-agent-mode-sessions"/*/*/*/.claude/.claude.json; do
    [ -f "$f" ] || continue; j=$(cat "$f")
    e=$(jget "$j" oauthAccount.emailAddress | lc); o=$(jget "$j" oauthAccount.organizationUuid)
    [ -n "$e" ] && [ -n "$o" ] && printf '%s\t%s\t%s\t%s\n' "$e" "$o" "$(jget "$j" oauthAccount.organizationName)" "$(jget "$j" oauthAccount.organizationType | sed 's/claude_//')"
  done | awk -F"$TAB" '!s[$1"|"$2]++' | tr '\t' '\037' | while IFS=$(printf '\037') read -r e o n t; do
    awk -F"$TAB" -v k="$e|$o" '$2=="claude" && ($4"|"$5)==k {f=1} END {exit !f}' "$REG" || grep -qxF "found:$e|$o" "$IGN" || printf '%s\t%s\t%s\t%s\n' "$e" "$o" "$n" "$t"
  done
}

cmd_signin() {
  if [ "$1" = claude ] && [ "$2" = --new ]; then shift 2; email=; sso=
    while [ $# -gt 0 ]; do case $1 in --email) email=$2; shift ;; --sso) sso=--sso ;; esac; shift; done
    n=$(next_name claude); d="$SH/accounts/$n"; mkdir -p "$d"
    echo "Signing a new Claude account in to $d. Pick the organization (personal or team) in the browser."
    CLAUDE_CONFIG_DIR="$d" "$(bin_for claude)" auth login ${email:+--email "$email"} $sso; refresh; exit 0
  fi
  l=$(reg_get "$1"); [ -n "$l" ] || die 2 "unknown sub '$1'."
  p=$(reg_field "$l" 2); d=$(reg_field "$l" 3); e=$(reg_field "$l" 4); b=$(bin_for "$p")
  echo "Sign in as $e."
  case $p in
    claude) if [ -n "$d" ]; then CLAUDE_CONFIG_DIR="$d" "$b" auth login --email "$e"; else env -u CLAUDE_CONFIG_DIR "$b" auth login --email "$e"; fi ;;
    codex) if [ -n "$d" ]; then CODEX_HOME="$d" "$b" login; else "$b" login; fi ;;
    cursor) "$b" login ;; gemini) "$b" ;; ollama) echo "Ollama has no sign-in." ;;
  esac
  refresh
}

cmd_remove() {
  l=$(reg_get "$1"); [ -n "$l" ] || die 2 "unknown sub '$1'."
  echo "$(reg_field "$l" 2):$(reg_field "$l" 3)" >> "$IGN"
  awk -F"$TAB" -v n="$1" '$1!=n' "$REG" > "$REG.t" && mv "$REG.t" "$REG"
  echo "Removed $1. Its sign-in stays; SubHub won't add it back. Undo: delete that line from $IGN."
}

case $1 in
  list) shift; cmd_list "$@" ;;
  models) shift; cmd_models "$@" ;;
  ask) shift; cmd_ask "$@" ;;
  status) shift; cmd_status "$@" ;;
  refresh) refresh; echo "Refreshed." ;;
  install) SRC_REPO=${SUBHUB_REPO:-$(cd "$SRC/../.." 2>/dev/null && pwd -P)}; cmd_install ;;
  connect|disconnect) c=$1; shift; SRC_REPO=${SUBHUB_REPO:-$(cd "$SRC/../.." 2>/dev/null && pwd -P)}
    for a in $(agents_arg "${1:-all}"); do $c "$a"; done ;;
  signin) shift; cmd_signin "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  on|off) cmd_onoff "$1" "$2" ;;
  config) echo "$CFG:"; cat "$CFG" 2>/dev/null || echo '(none yet: {"subs":{"<sub>":{"on":true,"use_for":"","model":"default","notes":""}},"order":[]})' ;;
  version|--version) echo "subhub $VERSION" ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
