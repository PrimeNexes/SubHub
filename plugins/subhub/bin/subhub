#!/bin/sh
# SubHub launcher (macOS, Linux). The engine is subhub.mjs next to this file; it needs Node.js 18+.
command -v node >/dev/null 2>&1 || { echo "SubHub needs Node.js 18 or newer: https://nodejs.org" >&2; exit 127; }
d=$(dirname "$0"); [ -L "$0" ] && d=$(dirname "$(readlink "$0")")
exec node "$d/subhub.mjs" "$@"
